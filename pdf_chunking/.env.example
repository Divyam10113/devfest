# LlamaParse API Key (get from https://cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=

# Google API Key for FREE embeddings (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# ChromaDB Configuration (local directory)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=compliance_docs

# Chunking Configuration
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=100

# File Upload Limits
MAX_FILE_SIZE_MB=50

# Server Configuration
PORT=8002
HOST=0.0.0.0

# Disable ChromaDB telemetry
CHROMA_ANONYMIZED_TELEMETRY=False

